# Public Supabase project settings (safe for the browser; access is enforced by row level security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-side only. Enables AI-assisted symptom extraction from free text (Arabic and English).
# The deterministic rules always run; AI output can only add symptoms, never remove warning signs.
# Gemini (free tier, https://aistudio.google.com/apikey) is used first if set; OpenAI is the fallback.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
